[
 {
  "name": "Payment Request",
  "doctype": "Print Format",
  "doc_type": "PMS Payment Request",
  "module": "Frappe PMS",
  "standard": "Yes",
  "custom_format": 0,
  "html": "<style>\n    .rfp-header { text-align:center; margin-bottom: 20px; }\n    .rfp-header h2 { margin:0; font-size:20px; }\n    .rfp-header .ref { font-size:14px; color:#555; }\n    .meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; margin:16px 0; }\n    .meta-item label { font-size:11px; color:#777; text-transform:uppercase; display:block; }\n    .meta-item span  { font-size:13px; font-weight:600; }\n    .status-badge { display:inline-block; padding:3px 10px; border-radius:12px;\n                    font-size:12px; font-weight:600; }\n    .status-Draft           { background:#dbeafe; color:#1e40af; }\n    .status-Submitted       { background:#fef3c7; color:#92400e; }\n    .status-Approved        { background:#d1fae5; color:#065f46; }\n    .status-Paid            { background:#d1fae5; color:#065f46; }\n    .status-Cancelled       { background:#fee2e2; color:#991b1b; }\n    table.items { width:100%; border-collapse:collapse; margin:16px 0; font-size:13px; }\n    table.items th { background:#f3f4f6; padding:8px; text-align:left; border-bottom:2px solid #e5e7eb; }\n    table.items td { padding:8px; border-bottom:1px solid #e5e7eb; }\n    table.items .amt { text-align:right; }\n    .total-row { font-weight:700; font-size:14px; }\n    .approval-trail { font-size:11px; color:#555; margin-top:20px; padding-top:10px;\n                      border-top:1px solid #e5e7eb; }\n    .approval-trail table { width:100%; }\n    .approval-trail td { padding:3px 6px; }\n</style>\n\n<div class=\"rfp-header\">\n    <h2>Request for Payment</h2>\n    <div class=\"ref\">{{ doc.name }}</div>\n</div>\n\n<div class=\"meta-grid\">\n    <div class=\"meta-item\">\n        <label>Employee</label>\n        <span>{{ doc.employee }}</span>\n    </div>\n    <div class=\"meta-item\">\n        <label>Date</label>\n        <span>{{ frappe.format(doc.date, {\"fieldtype\":\"Date\"}) }}</span>\n    </div>\n    {% if doc.project %}\n    <div class=\"meta-item\">\n        <label>Project</label>\n        <span>{{ doc.project }}</span>\n    </div>\n    {% endif %}\n    <div class=\"meta-item\">\n        <label>Department</label>\n        <span>{{ doc.department or \"\u2014\" }}</span>\n    </div>\n    <div class=\"meta-item\">\n        <label>Payment Type</label>\n        <span>{{ doc.payment_type }}</span>\n    </div>\n    <div class=\"meta-item\">\n        <label>Status</label>\n        <span class=\"status-badge status-{{ doc.status.replace(' ','') }}\">{{ doc.status }}</span>\n    </div>\n</div>\n\n<p><strong>Reason:</strong> {{ doc.description }}</p>\n\n<table class=\"items\">\n    <thead>\n        <tr>\n            <th>Date</th>\n            <th>Description</th>\n            <th>Account / Cost Center</th>\n            <th class=\"amt\">Amount ({{ doc.currency or \"SAR\" }})</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.items %}\n        <tr>\n            <td>{{ frappe.format(row.date, {\"fieldtype\":\"Date\"}) if row.date else \"\u2014\" }}</td>\n            <td>{{ row.description }}</td>\n            <td>{{ row.account or \"\u2014\" }}</td>\n            <td class=\"amt\">{{ frappe.format(row.amount, {\"fieldtype\":\"Currency\"}) }}</td>\n        </tr>\n        {% endfor %}\n        <tr class=\"total-row\">\n            <td colspan=\"3\" style=\"text-align:right\">Total</td>\n            <td class=\"amt\">{{ frappe.format(doc.total_amount, {\"fieldtype\":\"Currency\"}) }}</td>\n        </tr>\n    </tbody>\n</table>\n\n{% if doc.submitted_by %}\n<div class=\"approval-trail\">\n    <strong>Approval Trail</strong>\n    <table>\n        {% if doc.submitted_by %}\n        <tr><td>Submitted by</td><td>{{ doc.submitted_by }}</td>\n            <td>{{ frappe.format(doc.submitted_on, {\"fieldtype\":\"Datetime\"}) }}</td></tr>\n        {% endif %}\n        {% if doc.dept_approved_by %}\n        <tr><td>Dept. Approved by</td><td>{{ doc.dept_approved_by }}</td>\n            <td>{{ frappe.format(doc.dept_approved_on, {\"fieldtype\":\"Datetime\"}) }}</td></tr>\n        {% endif %}\n        {% if doc.fin_approved_by %}\n        <tr><td>Finance Approved by</td><td>{{ doc.fin_approved_by }}</td>\n            <td>{{ frappe.format(doc.fin_approved_on, {\"fieldtype\":\"Datetime\"}) }}</td></tr>\n        {% endif %}\n        {% if doc.final_approved_by %}\n        <tr><td>Final Approved by</td><td>{{ doc.final_approved_by }}</td>\n            <td>{{ frappe.format(doc.final_approved_on, {\"fieldtype\":\"Datetime\"}) }}</td></tr>\n        {% endif %}\n    </table>\n</div>\n{% endif %}\n",
  "css": "",
  "print_format_type": "Jinja"
 }
]