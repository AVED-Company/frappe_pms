 "fields": [
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "PMS Project",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "bold": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Data",
   "label": "Department",
   "in_list_view": 1
  },
  {
   "fieldname": "col_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
