  },
  {
   "fieldname": "payment_type",
   "fieldtype": "Select",
   "label": "Payment Type",
   "options": "\nCash\nBank Transfer\nCheck",
   "reqd": 1
  },
  {
   "fieldname": "col_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1,
   "bold": 1,
