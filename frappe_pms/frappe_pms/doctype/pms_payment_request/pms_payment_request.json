   "export": 1,
   "report": 1
  },
  {
   "role": "PMS Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "PMS Member",
   "read": 1,
   "write": 1,
