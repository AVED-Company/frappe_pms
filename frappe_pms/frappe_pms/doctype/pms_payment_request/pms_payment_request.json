   "fieldtype": "Section Break",
   "label": "Supporting Documents"
  },
  {
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Main Attachment"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "Additional Notes"
  },
  {
   "fieldname": "sec_audit",
   "fieldtype": "Section Break",
